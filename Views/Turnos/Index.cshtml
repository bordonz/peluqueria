@{
    ViewData["Title"] = "Turnos";
}

<div id="app" v-cloak>
    <h1>
        Turnos
        <div class="btn-group pull-right">
            <a class="btn btn-personalizado" href="/Turnos/Create" title="Crear">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-plus-fill" viewBox="0 0 16 16">
                    <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5z"/>
                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5zm4.5 6V9H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V10H6a.5.5 0 0 1 0-1h1.5V7.5a.5.5 0 0 1 1 0"/>
                </svg>
            </a>
        </div>
    </h1>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color: #23332a; color: #ffffff;">
                <tr>
                    <th class="py-3 ps-4">Turno</th>
                    <th class="py-3 ps-4">Emitido</th>
                    <th class="py-3 ps-4">Fecha</th>
                    <th class="py-3 ps-4">Estado</th>
                    <th class="py-3 ps-4">Id Cliente</th>
                    <th class="py-3 ps-4">Cliente Nombre</th>
                    <th class="py-3 ps-4">Cliente Apellido</th>
                    <th class="py-3 ps-4">Servicio</th>
                    <th class="py-3 ps-4">Estilista Nombre</th>
                    <th class="py-3 ps-4">Estilista Apellido</th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="turnos.length === 0">
                    <td colspan="11" class="text-center">No hay turnos registrados</td>
                </tr>
                <tr v-for="item in turnos" :key="item.idTurno">
                    <td>{{ item.idTurno }}</td>
                    <td>{{ formatearFecha(item.fechaEmitido) }}</td>
                    <td>{{ formatearFecha(item.fechaTurno) }}</td>
                    <td>{{ item.estado }}</td>
                    <td>{{ item.idCliente }}</td>
                    <td>{{ item.cliente?.nombre }}</td>
                    <td>{{ item.cliente?.apellido }}</td>
                    <td>{{ item.estilistaServicios?.servicio?.nombre }}</td>
                    <td>{{ item.estilistaServicios?.estilista?.nombre }}</td>
                    <td>{{ item.estilistaServicios?.estilista?.apellido }}</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a :href="`/Turnos/Edit/${item.idTurno}`" class="btn btn-personalizado" title="Editar">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                    <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                </svg>
                            </a>
                            <button type="button" class="btn btn-danger" @@click="eliminarTurno(item.idTurno)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eraser-fill" viewBox="0 0 16 16">
                                    <path d="M8.086 2.207a2 2 0 0 1 2.828 0l3.879 3.879a2 2 0 0 1 0 2.828l-5.5 5.5A2 2 0 0 1 7.879 15H5.12a2 2 0 0 1-1.414-.586l-2.5-2.5a2 2 0 0 1 0-2.828zm.66 11.34L3.453 8.254 1.914 9.793a1 1 0 0 0 0 1.414l2.5 2.5a1 1 0 0 0 .707.293H7.88a1 1 0 0 0 .707-.293z"/>
                                </svg>
                            </button>
                            @* <a :href="`/Turnos/TurnosDiarios/${item.idTurno}`" class="btn btn-personalizado" title="TurnosDiarios">Turnos de hoy</a> *@
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
    <div style="margin-top: 10px;">
        <button type="button" class="btn btn-personalizado" style="margin-right: 10px; @@click="cambiarPagina('atras')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
            </svg>
        </button>
        <button type="button" class="btn btn-personalizado" @@click="cambiarPagina('adelante')">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
            </svg>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const esEmpleado = @Json.Serialize(User.IsInRole("Empleado"));
        const { createApp, ref, onMounted } = Vue;

        createApp({
            setup() {
                const turnos = ref([]);
                const paginaActual = ref(1);
                const totalPaginas = ref(1);
                const tamPagina = 5;
                const contadorClicks = ref(1);

                const cargarTurnos = async (pagina) => {
                    try {
                        const response = await fetch(`/Turnos/ObtenerTurnos?pagina=${pagina}&tamPagina=${tamPagina}`, {
                            method: 'GET',
                            credentials: 'same-origin'
                        });
                        if (response.ok) {
                            const data = await response.json();
                            turnos.value = data.items;
                            totalPaginas.value = data.totalPaginas;
                            paginaActual.value = data.paginaActual;
                        }
                    } catch (error) {
                        console.error('Error al cargar los Turnos:', error);
                    }
                };

                const cambiarPagina = (direccion) => {
                    if (direccion === 'adelante' && paginaActual.value < totalPaginas.value) {
                        paginaActual.value++;
                        cargarTurnos(paginaActual.value);
                    } else if (direccion === 'atras' && paginaActual.value > 1) {
                        paginaActual.value--;
                        cargarTurnos(paginaActual.value);
                    }
                };

                const cargarPorSemana = async () => {
                    contadorClicks.value++;
                    if (contadorClicks.value > 4) {
                        contadorClicks.value = 1;
                    }

                    const url = `/Turnos/TurnosSemanales?numeroSemana=${contadorClicks.value}`;
                    try {
                        const response = await fetch(url, { credentials: 'same-origin' });
                        if (response.ok) {
                            turnos.value = await response.json();
                        } else if (response.status === 403 || response.status === 401) {
                            notyf.error("No tienes la autorización para esta acción");
                        } else {
                            notyf.error("No se pudieron cargar los turnos semanales");
                        }
                    } catch (error) {
                        console.error("Error al cargar los turnos semanales: ", error);
                    }
                };

                onMounted(async () => {
                    if(esEmpleado) {
                        await cargarPorSemana();
                    } else {
                        cargarTurnos(paginaActual.value);
                    }
                });

                const eliminarTurno = async(idTurno) => {
                    const result = await Swal.fire({
                        title: '¿Estás seguro?',
                        text: "La acción será irreversible",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Sí, cancelar',
                        cancelButtonText: 'Cancelar'
                    });

                    if (!result.isConfirmed) {
                        return;
                    }

                    try {
                        const response = await fetch(`/Turnos/Delete/${idTurno}`, {
                            method: 'POST',
                            credentials: 'same-origin'
                        });

                        if(response.ok) {
                            turnos.value = turnos.value.filter(t => t.idTurno !== idTurno);
                            notyf.info("Turno eliminado correctamente");
                        } else if (response.status === 403 || response.status === 401) {
                            notyf.error("No tienes la autorización para esta acción");
                        } else if (response.status === 400) {
                            notyf.error("No puedes cancelar un turno con menos de 24 horas de anticipación");
                        } else {
                            notyf.error("No se pudo eliminar el turno");
                        }
                    } catch(error) {
                        console.log("Error al intentar eliminar el turno: ", error);
                    }
                }

                const formatearFecha = (fechaStr) => {
                    if (!fechaStr) return '';
                    const fecha = new Date(fechaStr);
                    
                    return fecha.toLocaleDateString('es-AR', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: false
                    });
                };

                return {
                    turnos,
                    paginaActual,
                    totalPaginas,
                    cambiarPagina,
                    cargarPorSemana,
                    eliminarTurno,
                    formatearFecha
                };
            }
        }).mount('#app');
    </script>
}