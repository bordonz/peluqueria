@model IEnumerable<peluqueria.Models.Turno>

@{
	ViewData["Title"] = "Turnos";
}

<h1>
	Turnos
	<div class="btn-group pull-right">
		<a class="btn btn-primary" asp-action="Create" title="Crear">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-plus-fill" viewBox="0 0 16 16">
                <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5z"/>
                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5zm4.5 6V9H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V10H6a.5.5 0 0 1 0-1h1.5V7.5a.5.5 0 0 1 1 0"/>
            </svg>
        </a>
	</div>
</h1>
@* Si es admin mostrar los id, sino quitarlos, ademas si no es admin traer solo los de estado true *@
<table class="table table-striped">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.IdTurno)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.FechaEmitido)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.FechaTurno)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Estado)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.IdCliente)
			</th>
            <th>
				@Html.DisplayNameFor(model => model.Cliente.Nombre)
			</th>
            <th>
				@Html.DisplayNameFor(model => model.Cliente.Apellido)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.IdServicio)
			</th>
            <th>
				@Html.DisplayNameFor(model => model.Servicio.Nombre)
			</th>
            <th>
				@Html.DisplayNameFor(model => model.Servicio.Estilista.Nombre)
			</th>
            <th>
				@Html.DisplayNameFor(model => model.Servicio.Estilista.Apellido)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody id="tablaTurnos">
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.IdTurno)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.FechaEmitido)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.FechaTurno)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Estado)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.IdCliente)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Cliente.Nombre)
				</td>
                <td>
					@Html.DisplayFor(modelItem => item.Cliente.Apellido)
				</td>
                <td>
					@Html.DisplayFor(modelItem => item.IdServicio)
				</td>
                <td>
					@Html.DisplayFor(modelItem => item.Servicio.Nombre)
				</td>
                <td>
					@Html.DisplayFor(modelItem => item.Servicio.Estilista.Nombre)
				</td>
                <td>
					@Html.DisplayFor(modelItem => item.Servicio.Estilista.Apellido)
				</td>
				<td>
					<div class="btn-group" role="group">
						<a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.IdTurno" title="Editar">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                            </svg>
						</a>
						<a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.IdTurno" title="Eliminar">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eraser-fill" viewBox="0 0 16 16">
                                <path d="M8.086 2.207a2 2 0 0 1 2.828 0l3.879 3.879a2 2 0 0 1 0 2.828l-5.5 5.5A2 2 0 0 1 7.879 15H5.12a2 2 0 0 1-1.414-.586l-2.5-2.5a2 2 0 0 1 0-2.828zm.66 11.34L3.453 8.254 1.914 9.793a1 1 0 0 0 0 1.414l2.5 2.5a1 1 0 0 0 .707.293H7.88a1 1 0 0 0 .707-.293z"/>
                            </svg>
						</a>
						<a class="btn btn-primary" asp-action="TurnosDiarios" asp-route-id="@item.IdTurno" title="TurnosDiarios">Turnos de hoy</a>
						@* <a class="btn btn-primary" asp-action="TurnosDiarios" asp-route-id="@item.IdTurno" title="TurnosSemanales">Turnos semanales</a> *@
					</div>
				</td>
			</tr>
		}
	</tbody>
</table>
<div>
	<button type="button" data-controller="Turnos" data-action="Index" class="btn btn-primary" data-pagina="@ViewBag.pagina" onclick="cambiarPagina('atras', this)">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
			<path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
		</svg>
	</button>
	<button type="button" data-controller="Turnos" data-action="Index" class="btn btn-primary" data-pagina="@ViewBag.pagina" onclick="cambiarPagina('adelante', this)">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
			<path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
		</svg>
	</button>
	<button type="button" data-controller="Turnos" data-action="Index" class="btn btn-primary" data-pagina="@ViewBag.pagina" onclick="cargarPorSemana()">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pass-fill" viewBox="0 0 16 16">
			<path d="M10 0a2 2 0 1 1-4 0H3.5A1.5 1.5 0 0 0 2 1.5v13A1.5 1.5 0 0 0 3.5 16h9a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 12.5 0zM4.5 5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1m0 2h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1 0-1"/>
		</svg>
	</button>
</div>

<script>
    let contadorClicks = 0;

	function obtenerUrlSemana() {
		contadorClicks++;

		if (contadorClicks > 4) {
			contadorClicks = 1;
		}

		const url = `/Turnos/TurnosSemanales?numeroSemana=${contadorClicks}`;
		console.log(`Clic número: ${contadorClicks} -> Solicitando: ${url}`);
		
		return url;
	}
	
	async function cargarPorSemana() {
		try {
			const titulo = document.querySelector("h1 span");
			const url = obtenerUrlSemana();
			const response = await fetch(url);
			
			const data = await response.json();

			const tbody = document.querySelector("#tablaTurnos");
			tbody.innerHTML = "";

			data.forEach(turno => {
				tbody.innerHTML += `
					<tr>
						<td>${new Date(turno.fechaEmitido).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short', hour12: false })}</td>
						<td>${new Date(turno.fechaTurno).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short', hour12: false })}</td>
						<td>${turno.cliente.nombre}</td>
						<td>${turno.cliente.apellido}</td>
						<td>${turno.servicio.nombre}</td>
						<td>${turno.servicio.estilista.nombre}</td>
						<td>${turno.servicio.estilista.apellido}</td>
					</tr>
				`;
			});
		} catch (error) {
			console.error("Error al cargar los turnos semanales: ", error);
		}
	};
</script>
