@{
    ViewData["Title"] = "Servicios";
}

<h1>
    Servicios
    <div class="btn-group pull-right">
        @if (User.IsInRole("Administrador"))
        {
            <a class="btn btn-personalizado icon-link icon-link-hover" style="--bs-icon-link-transform: translate3d(0, -.125rem, 0);"
                href="/Servicios/CreateApi" title="Crear">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-plus-fill" viewBox="0 0 16 16">
                    <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5z"/>
                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5zm4.5 6V9H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V10H6a.5.5 0 0 1 0-1h1.5V7.5a.5.5 0 0 1 1 0"/>
                </svg>
            </a>
        }
    </div>
</h1>
<hr />

<div class="row" id="contenedorServicios">

</div>

<div class="mt-4" style="margin-bottom: 20px;">
    <button type="button" class="btn btn-personalizado" style="color: #ffffff;"
        onmouseover="this.style.backgroundColor='#198754';" onmouseout="this.style.backgroundColor='#344E41';" onclick="cambiarPagina('atras')">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>Anterior
    </button>
    <button type="button" class="btn btn-personalizado" style="color: #ffffff;"
        onmouseover="this.style.backgroundColor='#198754';" onmouseout="this.style.backgroundColor='#344E41';" onclick="cambiarPagina('adelante')">
        Siguiente <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
        </svg>
    </button>
    <button type="button" id="btnActivoInactivo" class="btn btn-primary" onclick="cambiarFiltro()"></button>
</div>

@section Scripts {
    <script>
        let paginaActual = 1;
        const tamPagina = 10;
        let estado = 'activo';
        let activoInactivo = true;
        const esAdmin = @User.IsInRole("Administrador").ToString().ToLower();

        function cambiarFiltro() {
            activoInactivo = !activoInactivo;
            actualizarEstadoBoton();
            cargarServicios(1);
        }

        function actualizarEstadoBoton() {
            let btn = document.getElementById('btnActivoInactivo');
            if (activoInactivo) {
                btn.textContent = "Ver Inactivos";
                btn.className = "btn btn-outline-success";
            } else {
                btn.textContent = "Ver Activos";
                btn.className = "btn btn-outline-secondary btn-sm";
            }
        }

        function cargarServicios(pagina) {
            fetch(`/api/servicios?paginaNro=${pagina}&tamPagina=${tamPagina}&activo=${activoInactivo}`, {
                method: 'GET',
                credentials: 'same-origin'
            })
            .then(response => {
                if(response.status === 403) {
                    notyf.error("No tienes permisos para ver los servicios inactivos");
                }

                if(response.status === 400) {
                    notyf.error("Error al intentar ver los servicios inactivos");
                }
                return response.json();
            })
            .then(data => {
                let contenedor = document.getElementById('contenedorServicios');
                contenedor.innerHTML = '';

                data.forEach(item => {
                    let imagenSrc = item.avatar ? item.avatar : '/images/default-service.png';

                    let cardHtml = ''
                    let BtnAdmin = '';

                    if(esAdmin) {
                        let btnClase = item.activo ? "btn-outline-danger" : "btn-outline-success";
                        let btnTexto = item.activo ? "Desactivar" : "Activar";
                        let btnAccion = `<button class="btn btn-sm btn-outline-success ${btnClase}}" onclick="cambiarServicio(${item.idServicio})">${btnTexto}</button>`;

                        BtnAdmin = `
                            <div class="d-flex gap-2" role="group">
                                <a class="btn btn-sm btn-outline-success" href="/Servicios/EditApi/${item.idServicio}" title="Editar">Editar</a>
                                ${btnAccion}
                            </div>
                        `
                    }
                    
                    cardHtml += `
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm"">
                                <img src="${imagenSrc}" class="card-img-top" alt="Imagen de ${item.nombre}" style="height: 420px; object-fit: cover;">
                                
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-success">${item.nombre}</h5>
                                    <p class="card-text text-muted mb-2">${item.descripcion}</p>
                                    
                                    <ul class="list-group list-group-flush mb-3">
                                        <li class="list-group-item px-0"><strong>Duración:</strong> ${item.duracion}</li>
                                        <li class="list-group-item px-0"><strong>Precio:</strong> $${item.precio}</li>
                                        <li class="list-group-item px-0"><strong>Activo:</strong> ${item.activo ? 'Sí' : 'No'}</li>
                                    </ul>

                                    <div class="mt-auto d-flex justify-content-between align-items-center">
                                        ${BtnAdmin}
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    contenedor.innerHTML += cardHtml;
                });
            })
            .catch(error => console.error('Error al cargar servicios: ', error));
        }
        
        function cambiarServicio(id) {
            fetch(`/api/servicios/${id}/BajaAlta`, {
                method: 'DELETE',
                credentials: 'same-origin'
            })
            .then(response => {
                if(response.ok) {
                    cargarServicios(paginaActual);
                    notyf.info('Operacion completada')
                } else {
                    notyf.error('No se pudo completar la operación');
                }
            })
            .catch(error => console.error('Error en baja/alta de servicio: ', error));
        }

        function cambiarPagina(direccion) {
            if (direccion === 'adelante') {
                paginaActual++;
            } else if (direccion === 'atras' && paginaActual > 1) {
                paginaActual--;
            }
            cargarServicios(paginaActual);
        }

        document.addEventListener("DOMContentLoaded", () => {
            actualizarEstadoBoton();
            cargarServicios(paginaActual);
        });
    </script>
}