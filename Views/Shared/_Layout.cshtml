<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Navajas</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/peluqueria.styles.css" asp-append-version="true" />
    <style>
        .bg-custom {
            background-color: #344E41 !important;
        }
</style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
    <!-- Select2 + Theme Bootstrap 4 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@ttskch/select2-bootstrap4-theme@1.5.2/dist/select2-bootstrap4.min.css" />
    @RenderSection("Styles", required: false)
</head>
<body onload="init()">
    @{
		bool IsAuthenticated = User?.Identity?.IsAuthenticated ?? false;
		var NombreUsuario = User?.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? "";
		var IsAdmin = User?.IsInRole("Administrador") ?? false;
	}
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-custom box-shadow mb-3">
            <div class="container-fluid">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-decoration-none icon-link icon-link-hover" style="--bs-icon-link-transform: translate3d(0, -.125rem, 0); color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';"asp-area="" asp-controller="Home" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-house-door-fill" viewBox="0 0 16 16">
                                <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5"/>
                            </svg>
                            Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="text-decoration-none nav-link" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" asp-area="" asp-controller="Servicios" asp-action="IndexApi">
                            Servicios
                        </a>
                    </li>

                    @if (IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="text-decoration-none nav-link" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="text-decoration-none nav-link" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" asp-area="" asp-controller="Turnos" asp-action="Index">Turnos</a>
                        </li>
                        @if (IsAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-decoration-none" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-decoration-none" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" asp-area="" asp-controller="EstilistaServicios" asp-action="VincularEstilista">Vincular Servicio</a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (!IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-decoration-none" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" href="@Url.Action("Login", "Usuarios")">
                                <i class="fa-solid fa-right-to-bracket"></i> Acceder
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-decoration-none" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" asp-controller="Usuarios" asp-action="Perfil">
                                <i class="fa-solid fa-user"></i> @NombreUsuario
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-decoration-none" style="color: #ffffff;" onmouseover="this.style.color='#198754';" onmouseout="this.style.color='#ffffff';" asp-controller="Usuarios" asp-action="Logout">
                                <i class="fa-solid fa-right-from-bracket"></i> Salir
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

        <!-- Plugins por CDN -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script type="text/javascript">
		const notyf = new Notyf({
			duration: 8500,
			types: [
				{
					type: 'info',
					background: '#056C5C',
					icon: {
						className: 'fa-solid fa-circle-info',
						tagName: 'i',
						color: 'white'
					}
				},
                {
                    type: 'error',
                    background: '#e63946',
                    icon: {
                        className: 'fa-solid fa-circle-exclamation',
                        tagName: 'i',
                        color: 'white'
                    }
                },
                {
                    type: 'success',
                    background: '#056C5C'
                }
			]
		});
        
		function init() {
			let error = "@(TempData["Error"] ?? ViewBag.Error ?? "")";
            let mensaje = "@(TempData["Mensaje"] ?? ViewBag.Mensaje ?? "")";
			let id = +"@(ViewBag.Id??0)";
			notyf.info = function(mensaje) {
				notyf.open({
					type: 'info',
					message: mensaje,
				});
			}
			if(error) {
				notyf.error(error);
			}
			if(mensaje) {
                notyf.open({
                    type: 'info',
                    message: mensaje
                });
			}
			if(id) {
				notyf.success(`La entidad fue dada de alta con id: ${id}`);
			}
		}
        function cambiarPagina(direccion, boton) {
            var paginaN = parseInt(boton.dataset.pagina);
            var controlador = boton.dataset.controller;
            var action = boton.dataset.action;
            var id = boton.dataset.id;
            if(direccion === "atras" && paginaN > 1) {
                paginaN --;
            } else if(direccion === "adelante") {
                paginaN ++;
            }
            var url = "/" + controlador + "/" + action + "?pagina=" + paginaN;
                if (id) {
                    url += "&id=" + id;
                }

            window.location.href = url;
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
