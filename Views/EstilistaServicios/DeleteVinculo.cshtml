@model peluqueria.Models.EstilistaServicio

@{
    ViewData["title"] = "Vinculo";
}

<h2>Eliminar vinculo</h2>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Delete">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group" style="margin-bottom: 10px;">
                <label class="control-label">Estilista</label>
                <select id="Usuario" class="form-control" name="IdEstilista">
                    <option value="@Model?.IdEstilista" selected>@Model?.Estilista?.Nombre @Model?.Estilista?.Apellido</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 10px;">
                <label class="control-label">Servicio</label>
                <select id="IdServicio" class="form-control" name="IdServicio" disabled>
                    <option value="">Seleccione un estilista primero</option>
                </select>
                <span asp-validation-for="IdServicio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Eliminar" class="btn btn-personalizado" style="margin-top: 10px;"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="VincularEstilista">Volver a vincular</a>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function() {
            $('#Usuario').select2({
                language: "es",
                theme: 'bootstrap4',
                placeholder: "Buscar estilista..",
                minimumInputLength: 3,
                maximumInputLength: 10,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    cache: true,
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Usuarios/Buscar/${q}`;
                    },
                    processResults: function (res) {
                        return {
                            results: res.datos.map(e => ({id: e.idUsuario, text: `${e.nombre} ${e.apellido}`}))
                        };
                    }
                }
            });

            $('#Usuario').on('change', async function() {
                let idEstilista = $(this).val();
                let $selectServicio = $('#IdServicio');

                $selectServicio.empty().append('<option value="">Cargando servicios...</option>').prop('disabled', true);

                if (!idEstilista) {
                    $selectServicio.empty().append('<option value="">Seleccione un estilista primero</option>');
                    return;
                }

                try {
                    let response = await fetch(`/EstilistaServicios/ObtenerServiciosPorEstilista?idEstilista=${idEstilista}`);
                    if (response.ok) {
                        let servicios = await response.json();
                        
                        $selectServicio.empty().append('<option value="">Seleccione un servicio</option>');
                        
                        if (servicios.length === 0) {
                            $selectServicio.append('<option value="" disabled>Este estilista no tiene servicios asignados</option>');
                        } else {
                            servicios.forEach(s => {
                                $selectServicio.append(`<option value="${s.idServicio}">${s.nombre}</option>`);
                            });
                            $selectServicio.prop('disabled', false);
                        }
                    } else {
                        $selectServicio.empty().append('<option value="">Error al cargar servicios</option>');
                    }
                } catch (error) {
                    console.error("Error de red:", error);
                    $selectServicio.empty().append('<option value="">Error de conexión</option>');
                }
            });
        });
    </script>
}