@model peluqueria.Models.EstilistaServicio

@{
    ViewData["title"] = "Crear vinculo";
}

<h4>Vincular estilista</h4>
<div class="row">
	<div class="col-md-4">
		<form asp-action="Create">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<div class="form-group">
				<label class="control-label">Estilista</label>
				<select id="Usuario" class="form-control" name="IdEstilista">
					<option value="@Model?.IdEstilista" selected>@Model?.Estilista.Nombre@Model?.Estilista.Apellido</option>
				</select>
			</div>
			<div class="form-group">
				<label asp-for="IdServicio"></label>
				@Html.DropDownListFor(m => m.IdServicio,
					(SelectList)ViewBag.Servicios,
					"Seleccione un tipo",
					new { @class = "form-control" })
				<span asp-validation-for="IdServicio" class="text-danger"></span>
			</div>
			<div class="form-group">
				<input type="submit" value="Create" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Volver a la Lista</a>
</div>

@section Scripts {
	<script type="text/javascript">
		$(document).ready(function() {
			$('#Usuario').select2({
				language: "es",
				theme: 'bootstrap4',
				placeholder: "Buscar estilista..",
				minimumInputLength: 3,
				maximumInputLength: 10,
				ajax: {
					delay: 250,
					dataType: "json",
					cache: true,
					//url: '/Usuario/Buscar',
					url: function (params) {
						let q = params.term ? encodeURIComponent(params.term) : "";
						return `/Usuarios/Buscar/${q}`;
					},
					processResults: function (res) {
						return {
							results: res.datos.map(e => ({id: e.idUsuario, text: `${e.nombre} ${e.apellido}`}))
						};
					}
				}
			});
		});
	</script>
}