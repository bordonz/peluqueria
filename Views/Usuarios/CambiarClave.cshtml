@model peluqueria.Models.Usuario

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="CambiarClave" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" name="id" value="@Model.IdUsuario" />

            @if (!User.IsInRole("Administrador"))
            {
                <div class="form-group mb-3">
                    <label class="control-label">Contraseña Actual</label>
                    <input type="password" name="claveAntigua" class="form-control" required />
                </div>
            }

            <div class="form-group mb-3">
                <label class="control-label">Nueva Contraseña</label>
                <input type="password" name="claveNueva" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Confirmar Nueva Contraseña</label>
                <input type="password" name="confirmarClave" class="form-control" required />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar Contraseña" class="btn btn-warning" />
                <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>